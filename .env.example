# ============================================================================
# Balles-Hosteleros — variables de entorno
# Copiar a .env.local y rellenar con valores reales. NO commitear .env.local.
# ============================================================================

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- URLs de la app ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_PRIMARY_HOSTS=localhost:3000

# ---------- Dev / Demo ----------
NEXT_PUBLIC_DEV_BYPASS_AUTH=
DEMO_EMAIL=
DEMO_PASSWORD=

# ---------- IA (Gemini) ----------
# Única key de IA del sistema: nóminas, soporte y asistente de páginas web.
GEMINI_API_KEY=
# Modelo por defecto: EXTRAER datos de texto (barato, la mayoria de usos).
GEMINI_MODEL=
# Modelo para leer FOTOS y PDF (albaranes, nominas). El modelo pequeno se
# inventa la estructura JSON en 1 de cada 2 documentos: ver lib/ia/gemini.ts.
GEMINI_MODEL_DOCUMENTOS=
# Modelo para REDACTAR texto que lee una persona (pulir correo, carta de baja).
GEMINI_MODEL_REDACCION=
# Tope de gasto de IA al mes, en euros (default 5). Al 80% se avisa por correo
# a EMAIL_ALERTAS; al 100% la IA se detiene hasta el dia 1 del mes siguiente.
IA_TOPE_EUROS_MES=

# ---------- Email transaccional (Resend) ----------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_FROM=
# Reply-To no-reply para TODOS los correos del software (capar respuestas al SaaS).
# Default si no se define: no-reply@balleshosteleros.com
EMAIL_NOREPLY=
# Aviso de cercanía al límite diario de envíos (Gmail ~2.000/día).
# EMAIL_LIMITE_AVISO: nº de envíos a partir del cual avisar (default 1800 = 90%).
# EMAIL_ALERTAS: buzón que recibe ese aviso (default balleshosteleros@gmail.com).
EMAIL_LIMITE_AVISO=
EMAIL_ALERTAS=

# ---------- Storage (Cloudflare R2) ----------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

# ---------- Banking / PSD2 (GoCardless) ----------
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
BANK_TOKENS_KEY=

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mismo valor que GOOGLE_CLIENT_ID, expuesto al navegador para el botón de
# Google Identity Services (One Tap / "Iniciar sesión como ...") en /login.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---------- Meta (Facebook / Instagram Ads) ----------
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=
META_INSTAGRAM_ACTOR_ID=
META_PAGE_ID=

# ---------- WhatsApp Cloud API (campañas de Marketing, Meta directo) ----------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=

# ---------- Avisos de reserva por WhatsApp y SMS (PRP-083) ----------
# Las credenciales del proveedor NO van aquí: se guardan cifradas por empresa
# en `empresa_mensajeria_config`, porque cada restaurante tiene su subcuenta.
#
# Aquí solo van los identificadores de las plantillas aprobadas por Meta, que
# son las mismas para todas las empresas. Fuera de las 24 h desde el último
# mensaje del cliente, Meta solo acepta plantillas que ha revisado una a una.
#
# Las variables de cada plantilla van en este orden:
#   {{1}} nombre del cliente   {{4}} hora
#   {{2}} nombre del restaurante   {{5}} personas
#   {{3}} fecha                {{6}} enlace para cancelar
WHATSAPP_PLANTILLA_CONFIRMACION=
WHATSAPP_PLANTILLA_RECONFIRMACION=
WHATSAPP_PLANTILLA_RECORDATORIO=
WHATSAPP_PLANTILLA_CANCELACION=

# ---------- Ágora TPV (POS) — Servicios de Integración ----------
# URL del ACMS (http://SERVIDOR:8984) y token del API HTTP de Ágora.
# OJO: no confundir con Agora.io (videollamadas) — esto es el TPV del restaurante.
AGORA_API_TOKEN=
AGORA_API_URL=

# ---------- Seguridad / Secrets ----------
CRON_SECRET=
QR_UPLOAD_SECRET=
TURNSTILE_SECRET=
CARTA_LIKE_SALT=
PAGINA_WEB_IP_SALT=

# ---------- Rate limits (Presentaciones) ----------
PRESENTACIONES_COOLDOWN_SEG=
PRESENTACIONES_MAX_POR_DIA=
PRESENTACIONES_MAX_POR_USUARIO_DIA=
